# ============================================================
# BakeryCloud - Variables de entorno del proyecto (raíz)
# Copia este archivo a .env y rellena los valores reales.
# NUNCA se sube .env al repositorio (ver .gitignore).
# ============================================================

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=bakerycloud
POSTGRES_USER=bakery
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_PORT=5432

# --- Config de tienda por defecto (desarrollo) ---
DEFAULT_TENANT_SLUG=tienda-demo

# --- Panel de administración (/admin/) ---
# ADMIN_PASSWORD es la contraseña de acceso al panel; ADMIN_SECRET firma los JWT.
# Si faltan, las rutas /api/admin responden 503.
ADMIN_PASSWORD=cambia_esta_password
ADMIN_SECRET=cambia_esta_clave_firma

# --- Almacenamiento de imágenes en S3 (producción) ---
# Sin esto, el backend usa el disco local (UPLOAD_DIR).
# En Fly.io (disco efímero), sin S3 las imágenes se pierden al redeploy.
#S3_BUCKET=bakerycloud-prod-uploads
#S3_REGION=eu-south-2

# --- Base de datos de producción ---
# Fly.io → usa Supabase (gratis, EU) o RDS:
#DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
