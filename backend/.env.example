# BakeryCloud - API (backend/.env)
# Copia este archivo a backend/.env

# Conexión a PostgreSQL (compatible con el docker-compose del repo)
DATABASE_URL=postgres://bakery:cambia_esta_password@localhost:5432/bakerycloud

# Puerto del servidor HTTP
PORT=3000

# Tenant que se resuelve cuando la petición no trae subdominio (desarrollo)
DEFAULT_TENANT_SLUG=tienda-demo
