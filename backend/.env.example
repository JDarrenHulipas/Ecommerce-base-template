# BakeryCloud - API (backend/.env)
# Copia este archivo a backend/.env

# Conexión a PostgreSQL (compatible con el docker-compose del repo)
DATABASE_URL=postgres://bakery:cambia_esta_password@localhost:5432/bakerycloud

# Puerto del servidor HTTP
PORT=3000

# Tenant que se resuelve cuando la petición no trae subdominio (desarrollo)
DEFAULT_TENANT_SLUG=tienda-demo

# Panel admin (/admin): contraseña de acceso y secreto para firmar tokens
# Si no se configuran, el panel y su API quedan desactivados (503)
ADMIN_PASSWORD=cambia_esta_password
ADMIN_SECRET=cambia_este_secreto
ADMIN_TOKEN_TTL=86400

# Carpeta donde se guardan las imágenes subidas (por defecto backend/uploads).
# En Docker se monta un volumen en /app/uploads (envio UPLOAD_DIR=/app/uploads).
#UPLOAD_DIR=

# --- Almacenamiento en S3 (opcional, para producción) ---
# Si S3_BUCKET está definido, las imágenes subidas por el admin se guardan en
# S3 en vez del disco local. En EC2 las credenciales las da el rol de instancia.
#S3_BUCKET=bakerycloud-prod-uploads
#S3_REGION=eu-south-2
#S3_ENDPOINT=http://localhost:4566   # solo para probar con LocalStack
